# Copia este archivo como .env.local para desarrollo local.
# En Vercel / Cloudflare Pages agrega estas mismas variables en el panel del proyecto.

# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://swblsrhhmwxrgdyubckb.supabase.co
# La "anon public key" (o la nueva "publishable key", sb_publishable_...). Es pública por diseño;
# la seguridad real la dan las políticas RLS de tus tablas.
VITE_SUPABASE_ANON_KEY=

# Radio máximo (en metros) para desbloquear la visita. Si no se define: 100.
VITE_RADIO_VISITA_M=100

# Estilo del mapa (opcional). Por defecto OpenFreeMap "liberty": gratis, sin API key.
# Otras opciones: https://tiles.openfreemap.org/styles/positron | /bright
VITE_MAP_STYLE_URL=
